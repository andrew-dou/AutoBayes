# Cluster settings for the scaling benchmark, sourced by setup.sbatch, run.sbatch and submit.sh (README.md).
# Every value spelled __FILL_...__ is a placeholder to be filled on the cluster; the scripts refuse to run while any is left.

# Everything is built and written under this directory (a fresh one: setup refuses an env/ it did not make, and every
# run writes into a new results/<date>-<tag>/; nothing is ever written into an existing results or fit directory).
BENCH_ROOT=/n/netscratch/king_lab/Everyone/adou/autobayes-bench
ENV_DIR=$BENCH_ROOT/env            # R library, CmdStan, the Python venv (setup.sbatch)
DATA_DIR=$BENCH_ROOT/data          # data/N<rows>/<model>.csv (setup.sbatch)
SRC_DIR=$BENCH_ROOT/src            # the AutoBayes checkout the runs use (README.md, step 1)

# Modules (check with `module spider R`, `module spider gcc`, `module spider python`).
R_MODULE=R/4.5.3-fasrc01              # R 4.5 if there is one (R 4.5.2 ran the local checks)
GCC_MODULE=gcc/13.2.0-fasrc01          # a C++17 compiler for CmdStan and for building rstan; "none" if the R module brings one
PYTHON_MODULE=none    # a Python 3.11 module, or "none": uv then downloads its own CPython 3.11 (setup.sbatch)
UV_BOOTSTRAP_MODULE=python/3.12.8-fasrc01    # any Python >= 3.8 to install uv from PyPI (the node's own python3 is 3.6); "none" if python3 is new enough
CMAKE_MODULE=cmake/3.31.6-fasrc01    # cmake >= 3.5, which RcppParallel (an rstan dependency) needs to build; "none" if on PATH

# SLURM
PARTITION=sapphire            # the CPU partition for setup and runs
ACCOUNT=king_lab                # --account, or "none" to leave it to the default
CONSTRAINT=sapphirerapids          # a node feature that pins one CPU model for every task (fair timings), or "none"
